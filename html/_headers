# Cloudflare headers (Pages / Workers static assets)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin

# CSS/JS are versioned (?v=...), fonts never change: cache 1 year
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
# images may be replaced under the same name: cache 30 days
/assets/img/*
  Cache-Control: public, max-age=2592000
# llms.txt: Vietnamese Markdown, declare UTF-8
/llms.txt
  Content-Type: text/plain; charset=utf-8
# admin: never indexed (not listed in robots.txt on purpose: it would advertise the path)
/admin/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex
  Cache-Control: no-cache
# self-hosted editor for the admin page
/vendor/*
  Cache-Control: public, max-age=2592000
